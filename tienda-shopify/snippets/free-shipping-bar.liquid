{%- comment -%}
  Barra de envío gratis. Solo aparece si configuras un importe en Ajustes del tema › Carrito
  (y debes tener esa misma tarifa de envío gratis creada en Shopify).
  El importe se convierte a la moneda del visitante con Shopify Markets.
{%- endcomment -%}
{%- if settings.free_shipping_threshold > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100 | times: cart.currency.rate | round
    assign total = cart.total_price
    assign remaining = threshold | minus: total
    if remaining < 0
      assign remaining = 0
    endif
    assign pct = total | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  -%}
  <div class="ship-bar{% if remaining == 0 %} ship-bar--done{% endif %}">
    {%- if remaining == 0 -%}
      {{ 'cart.free_shipping_done' | t }}
    {%- else -%}
      {%- assign remaining_money = remaining | money -%}
      {{ 'cart.free_shipping_left_html' | t: amount: remaining_money }}
    {%- endif -%}
    <div class="ship-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}"><div class="ship-bar__fill" style="--pct: {{ pct }}%"></div></div>
  </div>
{%- endif -%}
