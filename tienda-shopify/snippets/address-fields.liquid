<div class="form-grid form-grid--2">
  <label><span class="field__label">{{ 'customer.first_name' | t }}</span><input class="field__input" type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></label>
  <label><span class="field__label">{{ 'customer.last_name' | t }}</span><input class="field__input" type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></label>
</div>
<label><span class="field__label">{{ 'customer.addresses.address1' | t }}</span><input class="field__input" type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></label>
<label><span class="field__label">{{ 'customer.addresses.address2' | t }}</span><input class="field__input" type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></label>
<div class="form-grid form-grid--2">
  <label><span class="field__label">{{ 'customer.addresses.city' | t }}</span><input class="field__input" type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></label>
  <label><span class="field__label">{{ 'customer.addresses.zip' | t }}</span><input class="field__input" type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></label>
</div>
<label class="select"><span class="field__label">{{ 'customer.addresses.country' | t }}</span>
  <select class="select__select" name="address[country]" autocomplete="country">{{ all_country_option_tags }}</select>
</label>
<label><span class="field__label">{{ 'customer.addresses.province' | t }}</span><input class="field__input" type="text" name="address[province]" value="{{ form.province }}" autocomplete="address-level1"></label>
<label><span class="field__label">{{ 'contact.phone' | t }}</span><input class="field__input" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></label>
<label class="facet__check"><input type="checkbox" name="address[default]" value="1"{% if form.set_as_default_checkbox %} checked{% endif %}> {{ 'customer.addresses.set_default' | t }}</label>
