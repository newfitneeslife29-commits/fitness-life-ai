{%- comment -%} Logotipo de texto con símbolo propio. Se usa cuando no hay imagen de logo. {%- endcomment -%}
<span class="wordmark">
  <svg class="wordmark__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="9" fill="currentColor"/>
    <path d="M9 8.5h3.7v5.6l4.9-5.6h4.6l-5.8 6.4 6 8.1h-4.6l-4.1-5.7-1 1.1V23H9V8.5Z" fill="var(--paper)"/>
    <circle cx="24.2" cy="22.6" r="2.4" fill="var(--accent)"/>
  </svg>
  <span>{{ settings.brand_name | default: shop.name }}</span>
  {%- if settings.brand_suffix != blank -%}
    <span class="wordmark__suffix">{{ settings.brand_suffix }}</span>
  {%- endif -%}
</span>
