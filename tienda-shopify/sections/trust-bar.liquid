<div class="trust{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    <ul class="trust__list" style="--cols: {{ section.blocks.size | at_least: 1 }}">
      {%- for block in section.blocks -%}
        <li class="trust__item" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <span class="trust__icon">{% render 'icon', name: block.settings.icon %}</span>
          <div>
            <div class="trust__title">{{ block.settings.title | escape }}</div>
            {%- if block.settings.text != blank -%}<div class="trust__text">{{ block.settings.text }}</div>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Barra de confianza",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Fondo de color",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "Usa solo afirmaciones ciertas. Si dices \"envío gratis\" o \"30 días de devolución\", tu configuración de envíos y tu política deben decir lo mismo."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Garantía",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "default": "shield",
          "options": [
            {
              "value": "shield",
              "label": "Escudo"
            },
            {
              "value": "lock",
              "label": "Candado"
            },
            {
              "value": "truck",
              "label": "Camión"
            },
            {
              "value": "return",
              "label": "Devolución"
            },
            {
              "value": "chat",
              "label": "Chat"
            },
            {
              "value": "box",
              "label": "Caja"
            },
            {
              "value": "card",
              "label": "Tarjeta"
            },
            {
              "value": "globe",
              "label": "Mundo"
            },
            {
              "value": "gift",
              "label": "Regalo"
            },
            {
              "value": "sparkle",
              "label": "Destello"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "100% secure payment"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Texto",
          "default": "Encrypted Shopify checkout"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de confianza",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "lock",
            "title": "100% secure payment",
            "text": "Encrypted Shopify checkout"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Order tracking",
            "text": "We email you the tracking number"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "return",
            "title": "Returns",
            "text": "Read our policy"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "chat",
            "title": "Customer support",
            "text": "We reply by email"
          }
        }
      ]
    }
  ]
}
{% endschema %}
