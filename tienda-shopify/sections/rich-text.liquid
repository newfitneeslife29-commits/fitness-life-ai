{%- assign s = section.settings -%}
<section class="section{% if s.surface %} section--surface{% endif %}" style="--section-pt: {{ s.pt }}px; --section-pb: {{ s.pb }}px">
  <div class="page-width">
    <div class="{% if s.center %}center{% endif %}" style="max-width:820px;{% if s.center %}margin:0 auto{% endif %}" data-reveal>
      {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow | escape }}</span>{%- endif -%}
      {%- if s.title != blank -%}<h2>{{ s.title }}</h2>{%- endif -%}
      <div class="rte muted" style="font-size:1.08rem">{{ s.text }}</div>
      {%- if s.button_label != blank -%}<a class="btn" style="margin-top:24px" href="{{ s.button_link }}">{{ s.button_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Texto",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Write your message here.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace"
    },
    {
      "type": "checkbox",
      "id": "center",
      "label": "Centrado",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Fondo suave",
      "default": false
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Espacio superior",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Espacio inferior",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Texto"
    }
  ]
}
{% endschema %}
