<div class="page-width">
  <div class="auth">
    <h1>{{ 'customer.reset.title' | t }}</h1>
    <p class="auth__sub">{{ 'customer.reset.sub' | t }}</p>
    {%- form 'reset_customer_password', class: 'form-grid' -%}
      {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label><span class="field__label">{{ 'customer.password' | t }}</span><input class="field__input" type="password" name="customer[password]" autocomplete="new-password" required></label>
      <label><span class="field__label">{{ 'customer.password_confirm' | t }}</span><input class="field__input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
      <button class="btn btn--accent btn--full btn--lg" type="submit">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Restablecer contraseña",
  "settings": []
}
{% endschema %}
