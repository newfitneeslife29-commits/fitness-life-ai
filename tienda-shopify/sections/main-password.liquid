<div style="position:relative;min-height:100svh;display:grid;place-items:center;color:#fff;isolation:isolate;padding:32px 16px">
  <div class="brand-canvas" style="z-index:-1" aria-hidden="true">
    <span class="brand-canvas__blob brand-canvas__blob--1"></span>
    <span class="brand-canvas__blob brand-canvas__blob--2"></span>
    <span class="brand-canvas__blob brand-canvas__blob--3"></span>
    <span class="brand-canvas__grid"></span>
  </div>
  <div style="max-width:560px;text-align:center">
    <div style="font-size:1.6rem;margin-bottom:28px">{% render 'wordmark' %}</div>
    <h1 class="display" style="font-size:clamp(2.4rem,7vw,4.4rem)">{{ section.settings.title | escape }}</h1>
    {%- if shop.password_message != blank -%}<p style="opacity:.85;font-size:1.1rem">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter__form', style: 'margin-top:28px' -%}
      <input type="hidden" name="contact[tags]" value="prelanzamiento">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" style="width:100%">{{ 'sections.newsletter.success' | t }}</p>
      {%- else -%}
        <input class="newsletter__input" type="email" name="contact[email]" required placeholder="{{ 'sections.newsletter.placeholder' | t }}" aria-label="{{ 'sections.newsletter.label' | t }}">
        <button class="btn btn--accent" type="submit">{{ 'password.notify' | t }}</button>
      {%- endif -%}
    {%- endform -%}
    <details style="margin-top:36px;opacity:.8">
      <summary style="cursor:pointer">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', style: 'display:flex;gap:8px;margin-top:14px;justify-content:center' -%}
        <input class="newsletter__input" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}" aria-label="{{ 'password.password' | t }}">
        <button class="btn btn--light" type="submit">{{ 'password.enter' | t }}</button>
        {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Página de lanzamiento",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Opening soon"
    }
  ]
}
{% endschema %}
