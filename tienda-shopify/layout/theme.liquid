<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_ink }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {%- capture seo_title -%}
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    {%- endcapture -%}
    <title>{{ seo_title | strip }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- unless settings.font_heading.system? -%}
      {{ settings.font_heading | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {%- endunless -%}
    {%- unless settings.font_body.system? -%}
      {{ settings.font_body | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {%- endunless -%}

    {%- liquid
      assign heading_bold = settings.font_heading | font_modify: 'weight', '800'
      assign body_bold = settings.font_body | font_modify: 'weight', 'bold'
      assign body_medium = settings.font_body | font_modify: 'weight', '600'
    -%}
    <style>
      {{ settings.font_heading | font_face: font_display: 'swap' }}
      {{ heading_bold | font_face: font_display: 'swap' }}
      {{ settings.font_body | font_face: font_display: 'swap' }}
      {{ body_bold | font_face: font_display: 'swap' }}
      {{ body_medium | font_face: font_display: 'swap' }}

      :root {
        --ink: {{ settings.color_ink }};
        --paper: {{ settings.color_paper }};
        --surface: {{ settings.color_surface }};
        --accent: {{ settings.color_accent }};
        --accent-text: {{ settings.color_accent_text }};
        --trust: {{ settings.color_trust }};
        --sale: {{ settings.color_sale }};
        --success: {{ settings.color_success }};
        --muted: color-mix(in srgb, {{ settings.color_ink }} 58%, {{ settings.color_paper }});
        --line: color-mix(in srgb, {{ settings.color_ink }} 10%, {{ settings.color_paper }});
        --line-strong: color-mix(in srgb, {{ settings.color_ink }} 20%, {{ settings.color_paper }});

        --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        --font-heading-weight: {{ settings.font_heading.weight }};
        --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
        --font-body-weight: {{ settings.font_body.weight }};
        --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};

        --page-width: {{ settings.page_width }}px;
        --radius: {{ settings.radius }}px;
        --radius-sm: {{ settings.radius | times: 0.65 | round }}px;
        --radius-lg: {{ settings.radius | times: 1.5 | round }}px;
        --logo-width: {{ settings.logo_width }}px;
        --card-ratio: {% case settings.card_image_ratio %}{% when 'portrait' %}4 / 5{% when 'natural' %}auto{% else %}1 / 1{% endcase %};

        --ease: cubic-bezier(.2, .7, .2, 1);
        --ease-out: cubic-bezier(.16, 1, .3, 1);
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      {%- if settings.animations %}
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-anim');
      {%- endif %}
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          productRecommendations: {{ routes.product_recommendations_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          error: {{ 'general.errors.generic' | t | json }},
          copied: {{ 'general.copied' | t | json }}
        },
        moneyFormat: {{ shop.money_format | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    <div class="toast" role="status" aria-live="polite" data-toast></div>

    {% render 'structured-data' %}
  </body>
</html>
