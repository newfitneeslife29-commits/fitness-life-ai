<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    {% render 'meta-tags' %}
    <style>
      {{ settings.font_heading | font_face: font_display: 'swap' }}
      {{ settings.font_body | font_face: font_display: 'swap' }}
      :root {
        --ink: {{ settings.color_ink }}; --paper: {{ settings.color_paper }}; --surface: {{ settings.color_surface }};
        --accent: {{ settings.color_accent }}; --accent-text: {{ settings.color_accent_text }}; --trust: {{ settings.color_trust }};
        --sale: {{ settings.color_sale }}; --success: {{ settings.color_success }};
        --muted: color-mix(in srgb, {{ settings.color_ink }} 58%, {{ settings.color_paper }});
        --line: color-mix(in srgb, {{ settings.color_ink }} 10%, {{ settings.color_paper }});
        --line-strong: color-mix(in srgb, {{ settings.color_ink }} 20%, {{ settings.color_paper }});
        --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        --font-heading-weight: {{ settings.font_heading.weight }};
        --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
        --font-body-weight: {{ settings.font_body.weight }};
        --heading-scale: 1; --radius: {{ settings.radius }}px; --radius-sm: 10px; --radius-lg: 24px; --page-width: 1440px;
        --ease: cubic-bezier(.2,.7,.2,1); --ease-out: cubic-bezier(.16,1,.3,1);
      }
      body { background: var(--ink); }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main>{{ content_for_layout }}</main>
  </body>
</html>
