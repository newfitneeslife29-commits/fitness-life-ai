# Copia este archivo como .env.mobile y llena los valores antes de "npm run android" / "npm run ios".
# URL pública del servidor online (HTTPS). Obligatoria: la app nativa no tiene servidor propio.
VITE_SERVER_URL=https://parques.tudominio.com
# Llaves públicas de RevenueCat (Project settings → API keys) para compras en Google Play / App Store.
VITE_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
