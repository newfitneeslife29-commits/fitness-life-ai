{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["/parques/packages/**", "/parques/apps/server/**", "/parques/apps/web/src/**", "/parques/apps/web/public/**", "/parques/apps/web/index.html", "/parques/package-lock.json", "/parques/Dockerfile"]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
