# Copy to .env.local and fill in. Only VITE_* values reach the browser, and
# they must be public by design (Supabase URL + anon key, Stripe Payment Link).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your-link

# Secrets are NOT set here. They live in Supabase:
#   supabase secrets set GEMINI_API_KEY=... STRIPE_SECRET_KEY=... STRIPE_WEBHOOK_SECRET=...
